# Copie para deploy/.env (o setup-ec2.sh faz isso e já preenche DOMAIN e as
# senhas). NUNCA faça commit do deploy/.env.

# --- Endereço público ---
# IP elástico da EC2 com TRAÇOS no lugar dos pontos + .sslip.io
# Ex.: IP 54.12.34.56  ->  DOMAIN=54-12-34-56.sslip.io
# Front: https://<DOMAIN>    API: https://api.<DOMAIN>
DOMAIN=

# --- Pastas ---
# Onde está o clone que tem a pasta Frontend/, relativo a ESTA pasta (deploy/).
# Front e back em clones separados (~/tcc/front e ~/tcc/back): ../../front
# Os dois no mesmo clone (ex.: branch main): ..
FRONT_DIR=../../front

# --- Banco (Postgres no próprio servidor) ---
DB_USERNAME=adm
DB_PASSWORD=
DB_NAME=mari_database

# --- Autenticação da API ---
# true = rotas protegidas exigem login. Em servidor público deixe true.
AUTH_ACTIVATED=true
JWT_SECRET=
JWT_EXPIRES_IN=1d

ORCHESTRATOR_AUTO=true

# --- Borda (Edge) ---
# A borda é quem conecta aqui (uplink): no Edge/server/.env dela,
#   BACKEND_URL=https://api.<DOMAIN>/edge
#   EDGE_TOKEN=<o mesmo valor daqui>
# Sem EDGE_TOKEN o back aceitaria qualquer borda: em servidor público é
# obrigatório (o docker-compose recusa subir sem ele).
EDGE_TOKEN=
EDGE_TIMEOUT_MS=3000
# Modo antigo (o back conecta na borda). Deixe VAZIO no servidor: com a
# borda também usando BACKEND_URL, cada estado chegaria duas vezes.
EDGE_URL=

# --- Front (gravado no build) ---
VITE_MARI_NETWORK_ID=0x1200
