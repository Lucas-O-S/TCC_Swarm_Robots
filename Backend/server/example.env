

DB_HOST=             # Nome do serviço, pode ser o ip ou localhost
DB_PORT=            # Porta padrão do Microsoft SQL
DB_USERNAME=          # O usuário configurado no SQL_USER
DB_PASSWORD=      # A senha configurada no SQL_PASSWORD
DB_NAME= SwarmRobotsDb    # O banco de dados configurado no SQL_DATABASE

AUTH_ACTIVATED=       # true/false - liga/desliga o JwtAuthGuard nas rotas protegidas
JWT_SECRET=           # Segredo usado pra assinar/validar o token JWT
JWT_EXPIRES_IN=       # Validade do token, ex.: 1d, 12h

SIMULATOR_FAKE_ADVERTISEMENT=false