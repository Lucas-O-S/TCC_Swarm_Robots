

DB_HOST=localhost 

DB_PORT=5432 

DB_USERNAME=adm 

DB_PASSWORD=123456 

DB_NAME=mari_database 

# Liga/desliga a autenticação JWT nas rotas protegidas. Com false, o 

# JwtAuthGuard libera geral (útil pra desenvolver sem precisar logar). 

AUTH_ACTIVATED=false 

JWT_SECRET=change-me 

JWT_EXPIRES_IN=1d 

SIMULATOR_FAKE_ADVERTISEMENT=false

GATEWAY_MODE=mari
MARI_NETWORK_ID=0x0001

MQTT_URL=mqtt://localhost:1883
MQTT_PROTOCOL_VERSION=5

MARI_PORT=/dev/tty.usbmodem0010500667003
MARI_BAUDRATE=1000000
