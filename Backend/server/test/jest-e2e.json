{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "setupFiles": ["<rootDir>/test/setup/env.ts"],
  "testTimeout": 30000,
  "collectCoverageFrom": ["src/**/*.ts", "!src/main.ts", "!src/**/*.spec.ts"],
  "coverageDirectory": "<rootDir>/coverage/e2e"
}
