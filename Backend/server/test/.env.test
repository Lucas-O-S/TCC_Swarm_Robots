# Ambiente dos testes de API (npm run test:e2e). Usa um banco separado
# (mari_test) no mesmo Postgres do docker-compose - ver test/README.md.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=adm
DB_PASSWORD=123456
DB_NAME=mari_test

# Rotas protegidas exigem token nos testes.
AUTH_ACTIVATED=true
JWT_SECRET=segredo-dos-testes
JWT_EXPIRES_IN=1h

# Sem atribuição automática e sem borda: o EdgeClient é simulado nos testes.
ORCHESTRATOR_AUTO=false
EDGE_URL=
