# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=adm
DB_PASSWORD=change-me
DB_NAME=mari_database
 
# Liga/desliga a autenticação JWT nas rotas protegidas. Com false, o
# JwtAuthGuard libera geral (útil pra desenvolver sem precisar logar).
AUTH_ACTIVATED=false
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
 
# Atribuição automática do orquestrador (entrega tasks pendentes a robôs em
# Auto). Com false o backend sobe com ela desligada; em runtime liga/desliga por
# PUT /orchestrator/auto. SemiAuto (atribuição manual) funciona nos dois casos.
ORCHESTRATOR_AUTO=true

# --- Borda (Edge/server) ---
# A API não fala mais com o hardware: comandos vão por HTTP pra borda e a
# telemetria chega pelo socket.io dela. Serial, Mari, MQTT do simulador e robô
# fake agora se configuram no .env da borda (Edge/server/.env.example).
EDGE_URL=http://localhost:3001

# Mesmo EDGE_TOKEN da borda. Vazio = não manda token (borda com
# EDGE_AUTH_ACTIVATED=false).
EDGE_TOKEN=

# Tempo máximo (ms) esperando a borda responder um comando.
EDGE_TIMEOUT_MS=3000
