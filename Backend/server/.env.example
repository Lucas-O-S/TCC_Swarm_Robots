# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=adm
DB_PASSWORD=change-me
DB_NAME=mari_database

# Liga/desliga a autenticação JWT nas rotas protegidas. Com false, o
# JwtAuthGuard libera geral (útil pra desenvolver sem precisar logar).
AUTH_ACTIVATED=false
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Robô fake do simulador: emite um advertisement de teste a cada 3s,
# pra exercitar a recepção sem hardware.
SIMULATOR_FAKE_ADVERTISEMENT=false

# --- Gateway / transporte ---
# Escolhe o transporte: "mari" = hardware real (serial); qualquer outro
# valor (ou vazio) = simulador. O GatewayModule lê isto.
GATEWAY_MODE=simulator

# Serial do gateway Mari (só usado com GATEWAY_MODE=mari).
# Linux: /dev/ttyACM0   |   Windows: COM3
MARI_PORT=/dev/ttyACM0
MARI_BAUDRATE=1000000
# id da rede Mari - precisa bater com o firmware do gateway (Number() aceita 0x...)
MARI_NETWORK_ID=0x0001
