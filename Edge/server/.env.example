# --- Borda ---
# Porta do REST (/v1) e do socket.io (mesma porta). A API do front aponta pra
# cá com EDGE_URL.
EDGE_PORT=3001

# Token único da borda. Com false, REST e socket.io ficam abertos. Com true,
# o cliente manda "Authorization: Bearer <EDGE_TOKEN>" no REST e
# auth: { token } no socket.io (a API do front usa o EDGE_TOKEN do .env dela).
EDGE_AUTH_ACTIVATED=false
EDGE_TOKEN=change-me

# --- Gateway / transporte ---
# Escolhe o transporte:
#   mari      = hardware real (serial/HDLC)
#   mqtt      = RobotSwarmSimulator (frota simulada via broker MQTT)
#   simulator = fake, só loga hex (default)
GATEWAY_MODE=simulator

# Robô fake do modo simulator: emite um advertisement de teste a cada 3s,
# pra exercitar a recepção sem hardware.
SIMULATOR_FAKE_ADVERTISEMENT=false

# id da rede Mari (Number() aceita 0x...). No modo mari precisa bater com o
# firmware do gateway; no modo mqtt precisa bater com o network.id do cenário
# do simulador (exemplo.json usa "1200" -> 0x1200).
MARI_NETWORK_ID=0x0001

# Serial do gateway Mari (só usado com GATEWAY_MODE=mari).
# Linux: /dev/ttyACM0   |   macOS: /dev/tty.usbmodem...   |   Windows: COM3
MARI_PORT=/dev/tty.usbmodem0010500667001 
MARI_BAUDRATE=1000000
# Dar START automático nos robôs que aparecerem em Bootloader com imagem
# gravada. Todo power-on deixa o robô no bootloader, e nesse estado ele só
# emite SWARMIT_STATUS - fica invisível. Com false a borda não dá START: só
# pede o device-info (leitura: imagem e calibração LH2) e manda a calibração
# se LH2_CALIBRATION_FILE estiver preenchido. Robô sem imagem (Image: none)
# nunca recebe start, mesmo com true.
MARI_AUTO_START=true

# Calibração LH2 (só usado com GATEWAY_MODE=mari). Arquivo do
# `dotbot swarm lh2-calibration` (PyDotBot 0.30.0): calibration-*.toml ou
# calibration.out, caminho absoluto (o "~" não é expandido). Vazio = a borda
# não calibra ninguém e só repassa o estado lh2 que o robô reportar.
LH2_CALIBRATION_FILE=
# Pasta onde a captura da própria borda (POST /v1/lh2/calibration/session...)
# grava o TOML. Vazio = ~/.dotbot/calibrations, a mesma do PyDotBot. Depois de
# capturar, ponha o caminho do arquivo gerado no LH2_CALIBRATION_FILE para ele
# continuar carregado quando a borda reiniciar.
LH2_CALIBRATION_DIR=

# Broker MQTT (só usado com GATEWAY_MODE=mqtt).
# MQTT_PROTOCOL_VERSION=4 só pra brokers sem MQTT 5 (ex.: aedes em teste).
MQTT_URL=mqtt://localhost:1883
MQTT_PROTOCOL_VERSION=5

BACKEND_URL=
