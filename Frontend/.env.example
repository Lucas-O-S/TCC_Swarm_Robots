# URL base da API REST do backend NestJS.
VITE_API_URL=http://localhost:3000

# Broker MQTT (WebSocket) usado pela tela de Simulação para falar com o
# backend como se fosse o gateway + a frota (ver AGENTS.md, secao
# "Conexao com o RobotSwarmSimulator" e SIMULADOR_PLANO.md).
# É o mesmo Mosquitto do RobotSwarmSimulator (docker compose up -d),
# escutando em 9001/ws.
VITE_MQTT_WS_URL=ws://localhost:9001
# network_id em hex (4 dígitos), TEM que bater com o backend (MARI_NETWORK_ID)
# e com o cenário carregado no simulador.
VITE_MARI_NETWORK_ID=0x1200
